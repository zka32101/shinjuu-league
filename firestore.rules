rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserOwnData(userId) {
      return request.auth.uid == userId;
    }

    function isServerUpdate() {
      // Only Cloud Functions (no auth.uid) can perform these writes
      return request.auth == null;
    }

    function getUserAdminRole() {
      // Check if current user has an admin role document in admin_users collection
      // Returns role string ('admin', 'operator', 'viewer') or null if not an admin
      let adminDoc = get(/databases/$(database)/documents/admin_users/$(request.auth.uid));
      return adminDoc.data.get('role', null);
    }

    function isAdmin() {
      return isAuthenticated() && getUserAdminRole() == 'admin';
    }

    function isOperator() {
      return isAuthenticated() && getUserAdminRole() == 'operator';
    }

    function isViewer() {
      return isAuthenticated() && getUserAdminRole() == 'viewer';
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    // Rules: User can read/write own profile data only
    // Server (Cloud Functions) can write Elo/stats fields
    // ============================================================================
    match /users/{userId} {
      // User can read their own document
      allow read: if isUserOwnData(userId);

      // User can update their own non-sensitive fields.
      // Uses diff(resource.data).affectedKeys() rather than
      // request.resource.data.keys(): for an update(), request.resource.data
      // is the FULL resulting document (existing fields merged with the
      // patch), so a plain .keys() check on it would always include every
      // sensitive field once it's ever been set once (e.g. eloRating after
      // onboarding) - matching on every single update() call regardless of
      // whether that call actually touches the field, and blocking even
      // unrelated updates like selecting a mecha or changing owned skins.
      // affectedKeys() correctly reflects only the keys this specific write
      // adds, removes, or changes.
      allow update: if isUserOwnData(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'eloRating', 'rank', 'level', 'winRate', 'totalWins', 'totalBattles',
          'achievementBadges', 'gems', 'gold', 'createdAt', 'lastBattleAt'
        ]);

      // User can create their own document (onboarding)
      allow create: if isUserOwnData(userId) && !request.resource.data.keys().hasAny([
        'eloRating', 'rank', 'winRate', 'totalWins', 'totalBattles',
        'achievementBadges', 'gems', 'gold'
      ]);

      // Only server can update sensitive fields (Elo, stats, currency)
      // This is enforced via Cloud Functions triggered by battle/result
      allow write: if isServerUpdate();

      // Delete not allowed (archival only via Cloud Functions)
      allow delete: if false;

      // Subcollections under user (achievements, settings, etc)
      match /achievements/{achievementId} {
        allow read: if isUserOwnData(userId);
        allow write: if isUserOwnData(userId);
      }

      match /settings/{settingId} {
        allow read: if isUserOwnData(userId);
        allow write: if isUserOwnData(userId);
      }

      // Per-season rank/win-streak/tier tracking (RankingService). Not yet
      // migrated to a server-authoritative Cloud Function the way battle
      // Elo is (see /battle_results below), so it follows its current
      // actual trust model: fully client-writable for its own owner. A
      // player could inflate their own displayed tier-transition history
      // here, but this has no effect on their real (server-authoritative)
      // eloRating or on other players' data.
      match /season_data/{seasonId} {
        allow read, write: if isUserOwnData(userId);
      }

      // Seasonal reward distributions (SeasonRewardService). Created only
      // by the onSeasonEnded Cloud Function (Admin SDK bypasses rules), so
      // the client is never allowed to create/replace one - only to flip
      // its own claimedAt when claiming.
      match /season_rewards/{seasonId} {
        allow read: if isUserOwnData(userId);
        allow update: if isUserOwnData(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt']);
        allow write: if isServerUpdate();
      }

      // Skill tree reset history/snapshots across seasons
      // (SkillTreeResetService). Client-computed, same trust model as
      // season_data above.
      match /season_resets/{seasonId} {
        allow read, write: if isUserOwnData(userId);
      }

      match /season_snapshots/{seasonId} {
        allow read, write: if isUserOwnData(userId);
      }

      // Player inventory (ItemService: purchase/equip/unequip/sell). New
      // items are granted only by the item-purchase-validator Cloud
      // Function, which deducts gold server-side after checking the
      // catalog price and the user's actual balance (gold is denylisted
      // for direct client writes above, same as eloRating) - a client
      // create() here would bypass that check entirely. Equip/unequip/sell
      // don't touch currency, so they stay client-writable.
      match /items/{itemId} {
        allow read: if isUserOwnData(userId);
        allow create: if isServerUpdate();
        allow update, delete: if isUserOwnData(userId);
      }

      // Daily/weekly quest progress (FirestoreService.savePlayerQuest and
      // friends). Never had a rule at all - same missing-collection bug as
      // items above, breaking the whole quest system.
      match /quests/{questId} {
        allow read, write: if isUserOwnData(userId);
      }
    }

    // ============================================================================
    // REPLAYS COLLECTION
    // ============================================================================
    // Rules: Owner can read/write own replays
    // Everyone can read replays (for sharing/viewing)
    // ============================================================================
    match /replays/{replayId} {
      // Anyone can read replays (enables sharing via link)
      allow read: if true;

      // Only owner (userId == auth.uid) can write/delete their replays
      allow write: if isAuthenticated() && isUserOwnData(resource.data.userId);
      allow delete: if isAuthenticated() && isUserOwnData(resource.data.userId);

      // Create own replay
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // FRIEND REQUESTS COLLECTION
    // ============================================================================
    // Rules: Users can read/write their own friend requests
    // Collection name matches FirestoreService's actual 'friend_requests'
    // (snake_case) - this previously said 'friendRequests' (camelCase),
    // which doesn't exist anywhere in the app, so every friend-request
    // read/write fell through to the deny-all fallback below.
    // ============================================================================
    // Field names match FriendRequest.toJson() (fromUserId/toUserId) - this
    // previously checked senderId/receiverId, which don't exist on any real
    // document, so every clause here always evaluated false regardless of
    // the collection-name fix above.
    match /friend_requests/{requestId} {
      // User can read requests where they are sender or receiver
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      // User can create request (becomes sender)
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;

      // Only receiver can accept/reject request
      allow update: if isAuthenticated() && resource.data.toUserId == request.auth.uid;

      // Sender can delete own request (before acceptance)
      allow delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
    }

    // ============================================================================
    // GUILDS COLLECTION
    // ============================================================================
    // Rules: Guild members can read/write guild data
    // Guild owner can modify guild settings
    // ============================================================================
    match /guilds/{guildId} {
      // Anyone can read guild info (for search/join flow)
      allow read: if true;

      // Guild owner can update anything (settings, membership, etc).
      // Any other authenticated user can also update - but ONLY by adding
      // or removing exactly their own uid from memberIds (self-service
      // join/leave, FirestoreService.joinGuild()/leaveGuild(), called from
      // GuildViewModel/friends_screen.dart's join button and "脱退" leave
      // button). Before this, only the owner could update the document at
      // all, so a non-owner member clicking "脱退" (leave) - a live,
      // reachable button - always failed, and joinGuild() (dead code with
      // no caller until this change wires one up) would have failed too
      // the moment it was ever called.
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          (
            // Self-join: I wasn't a member, the new list is the old list
            // plus exactly me, and the guild isn't already full.
            (!resource.data.memberIds.hasAny([request.auth.uid]) &&
              request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
              request.resource.data.memberIds.hasAny([request.auth.uid]) &&
              request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
              request.resource.data.memberIds.size() <= resource.data.maxMembers) ||
            // Self-leave: I was a member, the new list is the old list
            // minus exactly me.
            (resource.data.memberIds.hasAny([request.auth.uid]) &&
              resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
              !request.resource.data.memberIds.hasAny([request.auth.uid]) &&
              resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1)
          )
        )
      );

      // Guild creation is a plain client write (FirestoreService.createGuild(),
      // called from GuildViewModel.createGuild() - there is no Cloud
      // Function involved at all), so requiring isServerUpdate() here meant
      // no real user could ever create a guild through the app's actual
      // "create guild" button (friends_screen.dart) - it always failed.
      // The creator must name themselves as the owner.
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Only owner can delete guild
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;

      // Guild members subcollection
      match /members/{memberId} {
        // Guild members can read member list
        allow read: if isAuthenticated();

        // Only guild owner can manage members
        allow write: if isAuthenticated() &&
          get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerId == request.auth.uid;
      }

      // Guild chat/bulletin board. FirestoreService.postToGuildBoard/
      // watchGuildPosts actually write to 'posts', not 'board' - this rule
      // named the wrong subcollection entirely, so every guild board
      // read/write fell through to the deny-all fallback below regardless
      // of who owned it.
      match /posts/{postId} {
        // Guild members can read posts
        allow read: if isAuthenticated();

        // Any authenticated user can create posts to guild board
        allow create: if isAuthenticated();

        // Post author can update/delete own posts
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // ============================================================================
    // LEADERBOARD COLLECTION
    // ============================================================================
    // Rules: Everyone can read leaderboard (public ranking)
    // Server only can write (updated via Cloud Functions after battle)
    // ============================================================================
    match /leaderboard/{leaderboardId} {
      // Anyone can read leaderboard
      allow read: if true;

      // Only server (Cloud Functions) can update
      allow write: if isServerUpdate();
      allow delete: if false;
    }

    // ============================================================================
    // MATCHMAKING QUEUE / MATCHES COLLECTIONS
    // ============================================================================
    // Rules: There is no dedicated matchmaking server - MatchmakingService
    // runs a client-driven protocol over these two collections instead.
    // A searching player writes their own /matchmaking_queue/{userId} entry,
    // then periodically looks for another compatible waiting entry and, on
    // finding one, claims it (in a transaction, so it can't be double-claimed)
    // by writing a /matchmaking_matches/{matchId} document and deleting the
    // claimed player's queue entry. The claimed player discovers the match by
    // querying matchmaking_matches for a document listing their own uid.
    // Neither collection previously had a rule at all.
    // ============================================================================
    match /matchmaking_queue/{userId} {
      // Every authenticated player must be able to see other players'
      // waiting entries to find opponents - the fields (userId/mode/
      // eloRating/mechaId/joinedAt) carry nothing sensitive.
      allow read: if isAuthenticated();

      // A player can only create their own waiting entry
      allow create: if isAuthenticated() && userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      // Claiming another player's entry requires deleting it (not just
      // your own, when you leave without matching) - so this is
      // intentionally not owner-restricted. Worst case a malicious client
      // deletes someone else's entry without actually matching them,
      // which only forces an earlier bot-filled fallback - no fairness or
      // security impact, since Elo/currency are never touched here.
      allow delete: if isAuthenticated();

      allow update: if false;
    }

    match /matchmaking_matches/{matchId} {
      // Only the real (non-bot) participants of this match can read it
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantUserIds;

      // The player who claims a match creates this document, and must
      // name themselves as one of its participants (so an unrelated
      // client can't fabricate a match involving someone else)
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantUserIds;

      allow update: if false;
      allow delete: if false;
    }

    // ============================================================================
    // BATTLES COLLECTION
    // ============================================================================
    // Rules: Battle owner can create/read/update their own battle record
    // (BattleViewModel.createBattle/updateBattle - Battle.userId, not a
    // participants list, since this is written from one player's own
    // client for their own battle). This collection previously had no
    // rule at all, so every createBattle()/updateBattle() call fell
    // through to the deny-all fallback below.
    // ============================================================================
    match /battles/{battleId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // eloProcessed/eloProcessedAt are set only by validateBattleResult
      // (Admin SDK, bypasses rules) once battle_results has been
      // processed - the client must never be able to set these itself,
      // which would let it fake "already processed" to block a
      // legitimate future Elo update for this battle.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eloProcessed', 'eloProcessedAt']);

      allow write: if isServerUpdate();
      allow delete: if false;
    }

    // ============================================================================
    // BATTLE RESULTS COLLECTION
    // ============================================================================
    // Rules: One document per submitting player (not per battle - this is
    // a 5v5 team game, not 1v1). The submitting user creates it after
    // their own battle ends; validateBattleResult (Cloud Function)
    // recalculates their Elo server-side and marks the battle processed.
    // Collection name matches the Cloud Function's actual trigger path
    // ('battle_results', snake_case) - this previously said
    // 'battleResults' (camelCase) and expected a 'participants' array,
    // neither of which exist anywhere in the app, so every battle result
    // ever submitted would have fallen through to the deny-all fallback.
    // ============================================================================
    match /battle_results/{battleResultId} {
      // User can read their own submitted battle results
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // User can create a battle result for themselves
      // Cloud Function validates and processes
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Cloud Functions can update (mark internal processing state)
      allow update: if isServerUpdate();

      // No deletes (audit trail)
      allow delete: if false;
    }

    // ============================================================================
    // ITEM PURCHASES COLLECTION
    // ============================================================================
    // Rules: Same "submit a request, server processes it" pattern as
    // battle_results above. The submitting user creates a request naming
    // only which catalog item they want; item-purchase-validator (Cloud
    // Function) looks up the real price server-side, checks their gold,
    // and marks this document processed either way so the client's
    // listener (with a timeout) knows the outcome.
    // ============================================================================
    match /item_purchases/{purchaseId} {
      // User can read their own submitted purchase requests
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // User can request a purchase for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Only the Cloud Function marks a request processed
      allow update: if isServerUpdate();

      // No deletes (audit trail)
      allow delete: if false;
    }

    // ============================================================================
    // ACHIEVEMENTS COLLECTION (Global Definitions)
    // ============================================================================
    // Rules: Everyone can read achievement definitions
    // ============================================================================
    match /achievements/{achievementId} {
      // Anyone can read achievement definitions
      allow read: if true;

      // Only server can create/update definitions
      allow write: if isServerUpdate();
      allow delete: if false;
    }

    // ============================================================================
    // SEASONS COLLECTION (Global Season Definitions)
    // ============================================================================
    // Rules: Everyone can read season definitions (tier thresholds, dates,
    // rewards catalog) - every client needs this to know the active season,
    // its tier thresholds, and past seasons. Never had a rule at all, so
    // SeasonService.getActiveSeason()/getSeasonById()/getPastSeasons() -
    // used throughout the ranking/season-progress feature - always failed
    // with a permission error, silently caught and treated as "no active
    // season" by every caller. season-lifecycle.ts (Cloud Function) is the
    // real writer; SeasonService.createSeason()/endSeason() exist as direct
    // client-write methods but are never called from the app UI - only
    // server writes are allowed here, matching achievements/config below.
    // ============================================================================
    match /seasons/{seasonId} {
      // Anyone can read season definitions
      allow read: if true;

      // Only server (Cloud Functions) can create/update seasons
      allow write: if isServerUpdate();
      allow delete: if false;
    }

    // ============================================================================
    // BATTLEPASSES COLLECTION
    // ============================================================================
    // Rules: Owner can read/write their own battle pass progress/premium
    // status. Never had a rule at all, so getBattlePass()/saveBattlePass()
    // (battlepass_screen.dart/shop_screen.dart) always failed, breaking the
    // whole battle pass feature. Like season_data, this is fully
    // client-trusted for now: RevenueCat purchase verification isn't wired
    // up yet (AppConfig.revenueCatApiKey is empty), so isPremium already has
    // no real anti-fraud protection regardless of this rule.
    // ============================================================================
    match /battlepasses/{battlePassId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================================================
    // CONFIG COLLECTION (Settings, Feature Flags, Remote Config)
    // ============================================================================
    // Rules: Everyone can read config (for client-side features)
    // Only server can write
    // ============================================================================
    match /config/{configId} {
      // Anyone can read config
      allow read: if true;

      // Only server can update
      allow write: if isServerUpdate();
      allow delete: if false;
    }

    // ============================================================================
    // ADMIN USERS COLLECTION (Phase 33: RBAC)
    // ============================================================================
    // Rules: Only admins can manage admin roles
    // Operators can view admin users
    // Regular users have no access
    // ============================================================================
    match /admin_users/{userId} {
      // Admin can read and write
      allow read, write: if isAdmin();

      // Operator can read (view admin assignments)
      allow read: if isOperator();

      // No deletes (archival via Cloud Functions only)
      allow delete: if false;
    }

    // ============================================================================
    // ADMIN ROLE AUDIT LOG COLLECTION (Phase 33: RBAC)
    // ============================================================================
    // Rules: Only admins can view role change history
    // Operators can view but not modify
    // Server can write (Cloud Functions)
    // ============================================================================
    match /admin_role_audit_log/{logId} {
      // Admin can read and write
      allow read, write: if isAdmin();

      // Operator can read (view audit trail)
      allow read: if isOperator();

      // Server can write (Cloud Functions)
      allow write: if isServerUpdate();

      // No deletes (audit trail immutability)
      allow delete: if false;
    }

    // ============================================================================
    // AUDIT LOG COLLECTION (Phase 33: RBAC)
    // ============================================================================
    // Rules: Admins can read all audit logs
    // Operators and Viewers can read audit logs
    // Server writes audit events (non-blocking from services)
    // ============================================================================
    match /audit_log/{logId} {
      // Admin can read all audit logs
      allow read: if isAdmin();

      // Operator can read all audit logs
      allow read: if isOperator();

      // Viewer can read all audit logs
      allow read: if isViewer();

      // Server can write (Cloud Functions + non-blocking service calls)
      allow write: if isServerUpdate();

      // No deletes (audit trail immutability)
      allow delete: if false;
    }

    // ============================================================================
    // FALLBACK - Deny everything else
    // ============================================================================
    match /{document=**} {
      allow read, write, delete: if false;
    }
  }
}
